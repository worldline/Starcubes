# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
env/
venv/
dist/
build/
*.egg-info/

# Logs and database files
*.log
/logs/

/static/
# Django's collectstatic destination — generated by `manage.py
# collectstatic` and `manage.py bootstrap`. Never committed.
staticfiles/
viz/dist/
# Vendored @hgruber/timeseries.js bundle — generated by the jsbuilder
# Dockerfile stage from node_modules/@hgruber/timeseries.js/dist/. The
# .gitkeep file in the same directory marks the path as intentionally
# present and is what tracks in git; the bundle itself is not committed.
viz/static/timeseries/timeseries.js
**/__pycache__/*
*~
*.swp

# Editor/IDE-specific files
.idea/
.vscode/
.claude/
.claw
.clawd-todos.json
*.sublime-project
*.tmproj

# Node — top-level npm install artefacts. The vendored timeseries.js bundle
# is generated by the jsbuilder Dockerfile stage from
# node_modules/@hgruber/timeseries.js/dist/timeseries.min.js, not committed.
node_modules/

# OS generated files
.DS_Store
Thumbs.db

# Local settings
local_settings.py
coverage.xml
.coverage
*.orig
starcubes.zip

# Database backup binaries (kept locally, not in git)
backups/
